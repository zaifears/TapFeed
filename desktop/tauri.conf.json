{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TapFeed",
  "version": "2.1.0",
  "identifier": "com.zaifears.tapfeed",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "TapFeed",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 620,
        "visible": false,
        "maximized": false,
        "center": true,
        "backgroundColor": "#101318"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self'; font-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"],
    "copyright": "zaifears",
    "publisher": "zaifears"
  }
}
